{
  "name": "ai-ops-platform",
  "private": true,
  "version": "1.0.0",
  "description": "PrjOps AI基盤 + AIエージェント主導DevOps運用基盤 統合モノレポ（14エージェント）",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "governance:check": "node scripts/check-codeowners.mjs",
    "traceability": "pnpm exec tsx packages/traceability/src/verifyTraceability.ts",
    "verify:all": "bash verification/run_verification.sh"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "typescript-eslint": "^8.15.0",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
