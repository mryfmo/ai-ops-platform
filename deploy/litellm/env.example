# 根拠: FinalArch:LLM-003 / FinalArch:FR-LLM-001..007 / ADR-0022 / ADR-0029
# Runtime environment contract for the LiteLLM inference proxy (values are
# injected from AWS Secrets Manager / task definition; keep this file valueless).
# AWS credentials come from the ECS task role via STS (P2-T03); long-lived
# AWS keys (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) are forbidden here.
# Enterprise enablement env (e.g. LITELLM_LICENSE) is forbidden per the Owner
# ruling in docs/security/2026-08-10-license-service-review-register.md.

LITELLM_MASTER_KEY=
LITELLM_DATABASE_URL=
LITELLM_PRICING_REVISION=

# Provider model IDs resolved only inside the proxy (never in applications).
BEDROCK_CLAUDE_GOVERNED_MODEL_ID=
BEDROCK_CLAUDE_STANDARD_MODEL_ID=
BEDROCK_CLAUDE_CODE_MODEL_ID=
BEDROCK_CLAUDE_FAST_MODEL_ID=
ANTHROPIC_CLAUDE_STANDARD_MODEL_ID=
ANTHROPIC_CLAUDE_NATIVE_MODEL_ID=
ANTHROPIC_CLAUDE_CODE_MODEL_ID=
ANTHROPIC_CLAUDE_FAST_MODEL_ID=

# Anthropic API key is distributed to this service only (Secrets Manager,
# P2-T04) and is bound per-deployment via litellm_params.api_key. The default
# ANTHROPIC_API_KEY name is forbidden: the always-mounted /anthropic
# passthrough route falls back to it, so keeping it unset leaves that route
# without a usable server credential. Bedrock uses the task role, not an env
# credential.
LITELLM_ANTHROPIC_API_KEY=

# OSS observability (ADR-0029: CloudWatch + OTel Collector).
OTEL_EXPORTER_OTLP_ENDPOINT=
