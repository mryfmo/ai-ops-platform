node_modules/
dist/
*.tsbuildinfo
.env
.env.*
coverage/
*.log
.DS_Store
__pycache__/

# Machine-local agent state only. Provider assets such as .agents/skills/,
# .codex/agents/, .codex/rules/ and .claude/hooks/ stay trackable because
# plans/012 intends to commit them. Without these entries Prettier scans the
# worklogs and `mise run ci` cannot go green while the agent workflow is used.
.agents/worklog/
.agents/runs/
.codex/hooks.json
.claude/settings.local.json
.crit/
.claude/contextdb/state/*
!.claude/contextdb/state/.gitkeep
.claude/contextdb/spool/incoming/*
!.claude/contextdb/spool/incoming/.gitkeep
.claude/contextdb/spool/quarantine/*
!.claude/contextdb/spool/quarantine/.gitkeep
.claude/contextdb/health/*
!.claude/contextdb/health/.gitkeep
