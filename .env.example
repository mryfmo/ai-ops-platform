# 根拠: ADR-0005 / REQ-032
# Server and web configuration inventory.
# Source of truth: packages/server/src/config.ts and packages/web/src/server/config.ts.
# Leave required values blank until deployment secrets and identifiers are provisioned.
# Optional entries are commented out so copying this file does not inject invalid empty strings.

# Required: shared PostgreSQL connection string.
# PostgreSQL connection used by the server and web data routes.
DATABASE_URL=

# Required: server public/authentication configuration.
# Random Graph notification clientState, at least 32 characters.
GRAPH_CLIENT_STATE=
# Random GitHub webhook HMAC secret, at least 32 characters.
GITHUB_WEBHOOK_SECRET=
# Microsoft Graph application client identifier.
GRAPH_CLIENT_ID=
# Microsoft Graph application client secret.
GRAPH_CLIENT_SECRET=
# Microsoft Graph tenant identifier.
GRAPH_TENANT_ID=
# Public server URL for callbacks and deep links.
PUBLIC_BASE_URL=
# Random coding-task confirmation/callback secret, at least 32 characters.
CODING_TASK_CALLBACK_SECRET=

# Required: web authentication configuration.
# Auth.js session secret.
AUTH_SECRET=
# Microsoft Entra application client identifier.
AUTH_MICROSOFT_ENTRA_ID_ID=
# Microsoft Entra application client secret.
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Microsoft Entra tenant identifier.
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# Optional: server defaults.
# Public Hono listen port.
PORT=8080
# Internal Next.js upstream port.
WEBUI_INTERNAL_PORT=3100
# Maximum PostgreSQL pool connections.
DB_POOL_MAX=10
# PostgreSQL connection acquisition timeout in milliseconds.
DB_POOL_CONNECTION_TIMEOUT_MS=5000
# PostgreSQL statement timeout in milliseconds.
DB_STATEMENT_TIMEOUT_MS=30000
# PostgreSQL idle-in-transaction timeout in milliseconds.
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=30000
# pino structured log level.
LOG_LEVEL=info
# OpenTelemetry service name.
OTEL_SERVICE_NAME=ai-ops-platform-server

# Optional: server integrations; omit unused variables from the deployed environment.
# OTLP base endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP traces endpoint; overrides the base endpoint for traces.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Anthropic API key for server and web LLM paths.
# ANTHROPIC_API_KEY=
# GitHub Projects v2 node identifier for snapshot reconciliation.
# GITHUB_PROJECT_NODE_ID=
# Outlook sender mailbox for report delivery.
# FROM_MAILBOX=
# Explicit report-delivery enable flag: true, false, 1, or 0.
REPORT_DELIVERY_ENABLED=false
# Report-ingest HMAC secret, at least 32 characters.
# REPORT_INGEST_SECRET=
# XLSX-import HMAC secret, at least 32 characters.
# XLSX_IMPORT_SECRET=
# Comma-separated owner/repository allowlist for XLSX execution.
# XLSX_IMPORT_ALLOWED_REPOS=
# Default Teams team identifier for report cards.
# DEFAULT_TEAMS_TEAM_ID=
# Default Teams channel identifier for report cards.
# DEFAULT_TEAMS_CHANNEL_ID=

# Optional: web page-agent limits; omit these variables to use handler defaults.
# Tool-step cap; accepted range 1-10.
# PAGE_AGENT_MAX_STEPS=
# Extended-thinking token budget; accepted range 1024-64000.
# PAGE_AGENT_THINKING_BUDGET_TOKENS=
