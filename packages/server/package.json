{
  "name": "@aiops/server",
  "version": "1.0.0",
  "description": "常駐サーバ（ADR-0005）: Graph/GitHub webhook受信、常駐ループ（ヘルスチェック/JIT失効/購読更新）、WebUIプロキシ",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "graph:smoke": "node dist/tools/graphSmoke.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs"
  },
  "dependencies": {
    "@aiops/devops": "workspace:*",
    "@aiops/prjops": "workspace:*",
    "@aiops/shared": "workspace:*",
    "@anthropic-ai/sdk": "0.111.0",
    "@azure/msal-node": "5.4.0",
    "@hono/node-server": "^1.13.7",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "hono": "^4.6.14",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "yaml": "^2.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "exceljs": "^4.4.0",
    "typescript": "^5.6.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
