{
  "name": "@aiops/server",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "常駐サーバ（ADR-0005）: Graph/GitHub webhook受信、常駐ループ（ヘルスチェック/JIT失効/購読更新）、WebUIプロキシ",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js",
      "default": "./dist/bootstrap.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "graph:smoke": "node dist/tools/graphSmoke.js",
    "events:requeue-dead": "node dist/tools/requeueDeadEvent.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs"
  },
  "dependencies": {
    "@aiops/devops": "workspace:*",
    "@aiops/integrations": "workspace:*",
    "@aiops/policy": "workspace:*",
    "@aiops/prjops": "workspace:*",
    "@aiops/shared": "workspace:*",
    "@anthropic-ai/sdk": "0.122.0",
    "@azure/msal-node": "5.4.3",
    "@hono/node-server": "^1.13.7",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "hono": "^4.13.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "exceljs": "^4.4.0",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
