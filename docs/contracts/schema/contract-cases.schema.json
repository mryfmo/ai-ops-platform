{
  "$comment": "Evidence: P010-F02-T01 / DEC-SPEC-001..004",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ops-platform.invalid/contracts/contract-cases.schema.json",
  "title": "Machine-judged contract cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["_evidence", "contract_version", "cases"],
  "properties": {
    "_evidence": { "const": "P010-F02-T01" },
    "contract_version": { "const": "1.0.0" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "schema_ref", "input", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "stage": { "enum": ["schema", "identity", "cross-reference", "checksum", "migration"] },
        "schema_ref": { "type": "string", "pattern": "^\\.\\./schema/[A-Za-z0-9.-]+\\.schema\\.json(#/.+)?$" },
        "input": {},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "error_code"],
          "properties": {
            "valid": { "type": "boolean" },
            "error_code": {
              "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^E-[A-Z0-9-]+$" }]
            }
          },
          "allOf": [
            {
              "if": { "properties": { "valid": { "const": true } }, "required": ["valid"] },
              "then": { "properties": { "error_code": { "type": "null" } } },
              "else": { "properties": { "error_code": { "type": "string" } } }
            }
          ]
        }
      }
    }
  }
}
