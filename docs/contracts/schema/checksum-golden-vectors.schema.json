{
  "$comment": "Evidence: P010-F02-T01 / DEC-SPEC-001",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ops-platform.invalid/contracts/checksum-golden-vectors.schema.json",
  "title": "prjops-data checksum golden vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["_evidence", "algorithm", "vectors"],
  "properties": {
    "_evidence": { "const": "P010-F02-T01" },
    "algorithm": { "const": "prjops-data-canonical-manifest-v1" },
    "vectors": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/vector" }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "entry_kind", "bytes_base64"],
      "properties": {
        "path": { "type": "string" },
        "entry_kind": { "enum": ["regular", "symlink", "directory", "fifo"] },
        "bytes_base64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "inputs",
        "expected_manifest_bytes_base64",
        "expected_content_sha256",
        "expected_error_code"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "category": {
          "enum": [
            "empty",
            "one",
            "multi",
            "order",
            "lf",
            "crlf",
            "bom",
            "nfc",
            "nfd",
            "path",
            "symlink",
            "boundary",
            "utf8",
            "nonregular"
          ]
        },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
        "expected_manifest_bytes_base64": {
          "oneOf": [
            { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
            { "type": "null" }
          ]
        },
        "expected_content_sha256": {
          "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }]
        },
        "expected_error_code": {
          "oneOf": [{ "type": "string", "pattern": "^E-SNAPSHOT-[A-Z0-9-]+$" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "expected_error_code": { "type": "null" } }, "required": ["expected_error_code"] },
          "then": {
            "properties": {
              "expected_manifest_bytes_base64": { "type": "string" },
              "expected_content_sha256": { "type": "string" }
            }
          },
          "else": {
            "properties": {
              "expected_manifest_bytes_base64": { "type": "null" },
              "expected_content_sha256": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
