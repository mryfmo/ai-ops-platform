{
  "$comment": "Evidence: ADR-0019 / P014-FA-T02",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ops-platform.invalid/contracts/plane-environment-mapping.schema.json",
  "title": "Plane environment mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["_evidence", "contract_version", "environment", "provenance", "projects"],
  "properties": {
    "_evidence": { "const": "ADR-0019 / P014-FA-T02" },
    "contract_version": { "const": "1.0.0" },
    "environment": { "enum": ["development", "production"] },
    "provenance": { "$ref": "#/$defs/provenance" },
    "projects": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^PJ-[0-9]+$": { "$ref": "#/$defs/projectMapping" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "environment": { "const": "development" } } },
      "then": { "properties": { "provenance": { "$ref": "#/$defs/developmentProvenance" } } },
      "else": { "properties": { "provenance": { "$ref": "#/$defs/productionProvenance" } } }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approval_basis",
        "signature",
        "replace_before_go_live",
        "replace_before_go_live_declaration"
      ],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approval_basis": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "replace_before_go_live": { "type": "boolean" },
        "replace_before_go_live_declaration": { "type": "string", "minLength": 1 }
      }
    },
    "developmentProvenance": {
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        {
          "properties": {
            "signature": { "const": "DEV-DEFAULT-unsigned" },
            "replace_before_go_live": { "const": true },
            "replace_before_go_live_declaration": {
              "const": "This DEV-DEFAULT mapping must be replaced with owner-signed real environment values before go-live."
            }
          }
        }
      ]
    },
    "productionProvenance": {
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        {
          "properties": {
            "signature": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
              "minLength": 16
            },
            "replace_before_go_live": { "const": false },
            "replace_before_go_live_declaration": {
              "const": "Owner-signed production mapping; DEV-DEFAULT values are forbidden."
            }
          }
        }
      ]
    },
    "projectMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plane_workspace_id", "plane_workspace_slug", "plane_project_id", "authorized_url"],
      "properties": {
        "plane_workspace_id": { "$ref": "#/$defs/uuid" },
        "plane_workspace_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "plane_project_id": { "$ref": "#/$defs/uuid" },
        "authorized_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        }
      }
    }
  }
}
