{
  "$comment": "Evidence: JIRA-GH-GOV-001 / 2026-08-28",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ops-platform.invalid/contracts/jira-environment-mapping.schema.json",
  "title": "Jira and GitHub governed environment mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["_evidence", "contract_version", "environment", "provenance", "projects"],
  "properties": {
    "_evidence": { "const": "JIRA-GH-GOV-001 / 2026-08-28" },
    "contract_version": { "const": "1.0.0" },
    "environment": { "enum": ["development", "production"] },
    "provenance": { "$ref": "#/$defs/provenance" },
    "projects": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": { "^PJ-[0-9]+$": { "$ref": "#/$defs/projectMapping" } },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "environment": { "const": "development" } } },
      "then": { "properties": { "provenance": { "$ref": "#/$defs/developmentProvenance" } } },
      "else": { "properties": { "provenance": { "$ref": "#/$defs/productionProvenance" } } }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approval_basis",
        "signature",
        "replace_before_go_live",
        "replace_before_go_live_declaration"
      ],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approval_basis": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "replace_before_go_live": { "type": "boolean" },
        "replace_before_go_live_declaration": { "type": "string", "minLength": 1 }
      }
    },
    "developmentProvenance": {
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        {
          "properties": {
            "signature": { "const": "DEV-DEFAULT-unsigned" },
            "replace_before_go_live": { "const": true },
            "replace_before_go_live_declaration": {
              "const": "This DEV-DEFAULT Jira mapping must be replaced with owner-signed real environment values before go-live."
            }
          }
        }
      ]
    },
    "productionProvenance": {
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        {
          "properties": {
            "signature": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
              "minLength": 16
            },
            "replace_before_go_live": { "const": false },
            "replace_before_go_live_declaration": {
              "const": "Owner-signed production Jira mapping; DEV-DEFAULT values are forbidden."
            }
          }
        }
      ]
    },
    "projectMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_version",
        "jira_cloud_id",
        "jira_project_id",
        "jira_project_key",
        "authorized_url",
        "github_repository",
        "allowed_status_ids",
        "protected_status_ids"
      ],
      "properties": {
        "mapping_version": { "type": "integer", "minimum": 1 },
        "jira_cloud_id": { "$ref": "#/$defs/uuid" },
        "jira_project_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "jira_project_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,29}$" },
        "authorized_url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "github_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "allowed_status_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
        },
        "protected_status_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
        },
        "sprint_field_id": { "type": "string", "pattern": "^customfield_[1-9][0-9]{0,15}$" }
      }
    }
  }
}
